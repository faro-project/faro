# faro-server settings for deploy/docker-compose.yml.
#
# Copy this file to faro.env (in this same folder), fill it in, and protect it:
#
#     cp faro.env.example faro.env
#     chmod 600 faro.env
#
# Rules for this file: one KEY=value per line, no spaces around "=", comments
# on their own lines. You do not need quotes, except: if a value contains a
# "$" (common in passwords), wrap the whole value in single quotes, e.g.
# FARO_SMTP_PASSWORD='pa$$word'.
#
# After changing anything here, apply it with:  docker compose up -d
# Every FARO_* variable is listed in server/faro.example.toml.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The address people and devices use to reach this instance. Must be https://
# and must be reachable from anywhere on the internet (not only your Wi-Fi).
FARO_PUBLIC_URL=https://faro.example.org

# Shown to members when they connect a computer ("Enroll in Grace Church Faro?").
FARO_INSTANCE_NAME=Grace Church Faro

# ---------------------------------------------------------------------------
# HTTPS: choose exactly ONE of mode A or mode B
# (and the matching "ports:" lines in docker-compose.yml)
# ---------------------------------------------------------------------------

# Mode A: built-in HTTPS. Faro gets a free certificate from Let's Encrypt by
# itself. Needs port 443 of this machine reachable from the internet and a DNS
# record pointing your domain here. The domain must be the one in FARO_PUBLIC_URL.
FARO_TLS_ACME_DOMAIN=faro.example.org
# Let's Encrypt emails this address if a certificate is about to expire.
FARO_TLS_ACME_CONTACT=admin@example.org

# Mode B: something else handles HTTPS in front of Faro (Caddy, nginx,
# Traefik, Cloudflare Tunnel, Tailscale Funnel). Comment out the two mode A
# lines above and uncomment this:
# FARO_BEHIND_PROXY=true

# ---------------------------------------------------------------------------
# Email (needed for sign-in links, invitations and alerts)
# ---------------------------------------------------------------------------

# Your provider's SMTP server. Port 587 + starttls is the usual choice;
# use port 465 with FARO_SMTP_TLS=tls if your provider says "SSL" or "465".
FARO_SMTP_HOST=smtp.example.org
FARO_SMTP_PORT=587
FARO_SMTP_TLS=starttls
FARO_SMTP_USERNAME=faro@example.org
FARO_SMTP_PASSWORD=change-me
# The sender people see. Many providers require it to be the account above.
FARO_SMTP_FROM=Faro <faro@example.org>

# ---------------------------------------------------------------------------
# Optional (defaults shown). Once you change these in the admin API they are
# stored in the database and the database value wins.
# ---------------------------------------------------------------------------

# invite-only | open | closed
# FARO_REGISTRATION_MODE=invite-only
# For open mode: who may sign up by themselves, e.g. college.edu
# FARO_ALLOWED_EMAIL_DOMAINS=college.edu

# How long the server keeps data, in days. Members may choose shorter.
# FARO_RETENTION_EVENT_HEADER_DAYS=90
# FARO_RETENTION_BLOB_DAYS=30
# FARO_RETENTION_ALERT_DAYS=90

# A computer silent for longer than this (seconds) triggers a missed-check-in alert.
# FARO_LIVENESS_GRACE_SECS=10800

# Sign-in/setup/enrollment requests allowed per minute from one address.
# FARO_RATE_LIMIT_PER_MINUTE=20

# Updates for members' computers (docs/SELF-HOSTING.md, "Updates for
# members' computers"). Off until FARO_UPDATES_ROOT is set; the Faro project
# hasn't published its root of trust or a release yet.
# FARO_UPDATES_ROOT=/usr/share/faro/update-root.json
# FARO_UPDATES_UPSTREAM=https://updates.faro-project.org/
# stable | stable-1 | beta. The admin console's Settings page can change it.
# FARO_UPDATES_CHANNEL=stable

# The beta supports SQLite only (the built-in default), the right choice for
# almost everyone. Postgres is EXPERIMENTAL and NOT supported in this release;
# doctor and the startup log warn about it (docs/SELF-HOSTING.md).
# FARO_DATABASE_URL=postgres://faro:secret@db/faro

# Log detail: info (default), or debug when asked to while troubleshooting.
# FARO_LOG=info

# Do NOT set FARO_DATA_DIR or FARO_LISTEN here: the image sets them to /data
# and 0.0.0.0:8080, and docker-compose.yml relies on those.
