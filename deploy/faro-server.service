# systemd unit for faro-server installed as a plain binary (no Docker).
#
# Install (as root; full walkthrough in docs/SELF-HOSTING.md):
#
#   install -m 0755 faro-server /usr/local/bin/faro-server
#   useradd --system --user-group --home-dir /var/lib/faro --no-create-home \
#           --shell /usr/sbin/nologin faro
#   install -d -m 0750 -o root -g faro /etc/faro
#   install -m 0640 -o root -g faro faro.toml /etc/faro/faro.toml   # from server/faro.example.toml
#   install -m 0644 faro-server.service /etc/systemd/system/faro-server.service
#   systemctl daemon-reload
#   systemctl enable --now faro-server
#   journalctl -u faro-server        # the one-time setup token is printed here on first start
#
# In /etc/faro/faro.toml set data_dir = "/var/lib/faro". systemd creates that
# directory on start (owned by faro, mode 0700) through StateDirectory= below,
# which is why first-time initialisation happens in `serve` rather than in a
# separate `faro-server init` run.
#
# Keep every setting, including the SMTP password, in faro.toml (root:faro,
# mode 0640). Hand-run commands such as
#   sudo -u faro faro-server doctor --config /etc/faro/faro.toml
#   sudo -u faro faro-server backup --config /etc/faro/faro.toml --out ...
# then see exactly the configuration the service uses. (FARO_* variables set
# with Environment= or EnvironmentFile= here would be invisible to them.)
#
# HTTPS: either built-in ACME (listen = "0.0.0.0:443" plus [tls] acme_domain),
# which needs the CAP_NET_BIND_SERVICE capability granted below, or behind a
# reverse proxy / tunnel (listen = "127.0.0.1:8080", behind_proxy = true), in
# which case you can empty the two capability lines (see the comments there).
#
# Check the sandbox with:  systemd-analyze security faro-server.service

[Unit]
Description=Faro self-hosted accountability instance
Documentation=https://github.com/faro-project/faro/blob/main/docs/SELF-HOSTING.md
Wants=network-online.target
After=network-online.target
# Using a local Postgres (experimental, not supported in this release)?
# Uncomment so the database starts first:
# After=network-online.target postgresql.service
# Wants=network-online.target postgresql.service

[Service]
Type=simple
User=faro
Group=faro
ExecStart=/usr/local/bin/faro-server serve --config /etc/faro/faro.toml
Restart=on-failure
RestartSec=5s
# faro-server stops on SIGTERM: drains requests, then gives workers up to 15 s.
TimeoutStopSec=30s

# /var/lib/faro: identity key, SQLite database, blobs, ACME certificate cache.
StateDirectory=faro
StateDirectoryMode=0700
WorkingDirectory=/var/lib/faro
# Everything faro-server creates is private to the faro user.
UMask=0077

# Binding port 443 for built-in ACME without running as root. Behind a proxy
# on a port >= 1024, set both lines to empty values
# ("CapabilityBoundingSet=" and "AmbientCapabilities=") to drop all capabilities.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Sandboxing. faro-server needs only: network sockets, read access to
# /etc/faro and the binary, and write access to its StateDirectory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# AF_UNIX: local Postgres socket and the system DNS resolver; AF_INET/6: HTTP(S), SMTP.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
