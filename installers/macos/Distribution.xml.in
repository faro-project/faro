<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Faro</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <!-- Installs for the whole computer only: every account is monitored. -->
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="@ARCHS@"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="org.faro.pkg"/>
    </choices-outline>
    <choice id="org.faro.pkg" visible="false" title="Faro">
        <pkg-ref id="org.faro.pkg"/>
    </choice>
    <pkg-ref id="org.faro.pkg" version="@VERSION@" onConclusion="none">faro-component.pkg</pkg-ref>
</installer-gui-script>
